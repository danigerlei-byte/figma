# Environment Variables for Vercel Project Settings
# Add these at: Vercel Dashboard -> Project -> Settings -> Environment Variables

# 1. Supabase Credentials (Found at: Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# 2. Resend API Key (Found at: Resend Dashboard -> API Keys)
RESEND_API_KEY=re_123456789abcdef

# 3. From Email Address
# Use 'onboarding@resend.dev' for free testing, or your verified domain e.g. 'hello@yourdomain.com'
FROM_EMAIL=onboarding@resend.dev
